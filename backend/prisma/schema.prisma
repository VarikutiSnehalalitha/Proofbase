// Proofbase Database Schema
// PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users & Authentication ──────────────────────────────────────────────

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  emailVerified  Boolean  @default(false)
  role           String   @default("candidate") // candidate | admin
  username       String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile           Profile?
  projects          Project[]
  collections       Collection[]
  activityLogs      ActivityLog[]
  analyticsEvents   AnalyticsEvent[]
  passwordResets    PasswordReset[]
  emailVerifications EmailVerification[]
  sharePermissions  SharePermission[] @relation("GrantedBy")
  receivedShares    SharePermission[] @relation("GrantedTo")

  @@index([email])
  @@index([username])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ─── Profiles ────────────────────────────────────────────────────────────

model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique
  name         String
  headline     String?
  bio          String?
  location     String?
  avatarUrl    String?
  website      String?
  githubUrl    String?
  linkedinUrl  String?
  twitterUrl   String?
  skills       String[] @default([])
  experience   String?
  isPublic     Boolean  @default(true)
  contactEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Projects ────────────────────────────────────────────────────────────

model Project {
  id           String   @id @default(uuid())
  userId       String
  name         String
  description  String?
  category     String?
  role         String?  // e.g. "Lead Developer", "Designer"
  organization String?
  startDate    DateTime?
  endDate      DateTime?

  // Contribution details
  responsibilities String?
  achievements     String?
  outcomes         String?

  // Status and visibility
  status     String @default("draft")  // draft | published | archived
  visibility String @default("private") // public | private | shared
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  files             ProjectFile[]
  externalLinks     ExternalLink[]
  skills            ProjectSkill[]
  collectionItems   CollectionProject[]
  shareLinks        ShareLink[]
  sharePermissions  SharePermission[]
  activityLogs      ActivityLog[]

  @@index([userId])
  @@index([status])
  @@index([visibility])
  @@index([category])
  @@index([createdAt])
}

model ProjectFile {
  id           String   @id @default(uuid())
  projectId    String
  filename     String   // stored filename (UUID-based)
  originalName String
  mimeType     String
  size         Int      // bytes
  storagePath  String   // relative path in storage
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ExternalLink {
  id        String   @id @default(uuid())
  projectId String
  title     String
  url       String
  type      String   @default("other") // github | gitlab | figma | website | docs | other
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectSkill {
  id        String @id @default(uuid())
  projectId String
  name      String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([name])
}

// ─── Collections ─────────────────────────────────────────────────────────

model Collection {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects CollectionProject[]

  @@index([userId])
}

model CollectionProject {
  id           String   @id @default(uuid())
  collectionId String
  projectId    String
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([collectionId, projectId])
}

// ─── Sharing ─────────────────────────────────────────────────────────────

model ShareLink {
  id          String    @id @default(uuid())
  projectId   String
  token       String    @unique
  expiresAt   DateTime?
  accessCount Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([projectId])
}

model SharePermission {
  id          String   @id @default(uuid())
  projectId   String
  grantedById String
  grantedToId String?  // null if shared by email to non-user
  email       String?  // email of recipient
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  grantedBy User    @relation("GrantedBy", fields: [grantedById], references: [id], onDelete: Cascade)
  grantedTo User?   @relation("GrantedTo", fields: [grantedToId], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
  @@index([projectId])
  @@index([grantedToId])
  @@index([email])
}

// ─── Activity & Analytics ────────────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  action     String   // created | updated | published | archived | shared | deleted | viewed
  entityType String   // project | profile | collection | file
  entityId   String
  metadata   Json?    // additional context
  createdAt  DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  type       String   // profile_view | project_view | share_click
  targetType String   // profile | project
  targetId   String
  userId     String?  // owner of the target
  visitorId  String?  // anonymous visitor fingerprint
  referrer   String?
  createdAt  DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([userId])
  @@index([createdAt])
  @@index([type])
}
